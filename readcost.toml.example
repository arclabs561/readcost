# Copy to readcost.toml at the repository root. Every key is optional; the
# values below are the defaults (tests/test_config_cli.py checks that).
[readcost]
model = "en_core_web_sm"        # "en_core_web_trf" parses better and is slower
profile = "default"             # or a JSON file from `readcost profile build`, relative to this file
baseline = ""                   # a file from `readcost baseline`, relative to this file; findings in it do not count
min_severity = "info"           # info | warn | error: drop findings below this
advise_severity = "error"       # info | warn | error | off: any finding this severe makes the verdict "advise"
allow = []                      # phrases never flagged, e.g. ["write-ahead log", "Block-Max WAND"]
comments = "doc"                # source files: "doc" comments only, or "all"
advise_cost_index = 15.0        # verdict "advise" at this many weighted findings per 1k words
block_cost_index = 30.0         # verdict "block" at this rate ...
block_min_points = 3.0          # ... and at least this many weighted findings
short_text_words = 40           # below this many words, judge by weighted findings, not the rate:
short_advise_points = 2.0       # "advise" at this many; "block" at block_min_points
commit_advise_cost_index = 50.0 # commit messages: "advise" at this rate (they are terser than prose)
commit_block_cost_index = 100.0 # commit messages: "block" at this rate
stacked_nouns_min = 3           # stacked-nouns: this many nouns in a row
long_dependency_z = 2.5         # long-dependency: z-score against the profile's fit
long_dependency_min_tokens = 10 # long-dependency: skip sentences with fewer tokens
long_dependency_core_min = 9   # long-dependency: words between a subject or object and its verb,
                               # in a sentence whose dependencies are long overall (z above)
long_dependency_core_always = 15 # long-dependency: that many words is reported at any z
inline_list_min_items = 4       # inline-list: this many conjoined items
long_sentence_words = 32        # long-sentence (opt-in): more than this many words
feedback_link = true            # text and agent output end with a link to report a wrong finding
language_check = true           # skip text that is clearly not English, with a note
overrides = []                  # [[readcost.overrides]] tables: per-path rule levels (see below)

# Rule levels: "error", "warn" or "info" turns a rule on at that severity
# (opt-in rules too); "ignore" turns it off. "all" sets every rule. Unlisted
# rules keep their default: on or off, at the detector's own severity.
[readcost.rules]
# stacked-nouns = "error"
# long-sentence = "info"
# hyphen-compound = "ignore"

# Per-path levels, applied in order after [readcost.rules]:
# [[readcost.overrides]]
# include = ["CHANGELOG.md", "docs/adr/*"]
# exclude = []
# rules = { inline-list = "ignore" }

[readcost.src]
include = ["*.md", "*.markdown", "*.mdx", "*.rst", "*.txt", "COMMIT_EDITMSG"]
exclude = ["CHANGELOG*", "*/node_modules/*", "*/target/*", "*/.git/*", "*/vendor/*",
           "*/.venv/*", "*/venv/*", "*/.tox/*"]
extend_exclude = []             # added to exclude, keeping the defaults above
respect_ignore_files = true     # skip what .gitignore and other git ignore files exclude

[readcost.hooks]
mode = "advise"                 # off | advise | block
stop = "off"                    # off | report | revise   (Claude Code Stop hook)
display = "off"                 # off | note             (Claude Code MessageDisplay)
edited_lines_only = true        # judge only the lines an edit touched
max_items = 8                   # findings sent back to a model
max_chars = 2500
timeout_seconds = 8.0           # not read yet
